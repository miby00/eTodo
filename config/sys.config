%% Defaults only. Put your own settings and folders in etodo.toml, see
%% config/etodo.toml.example and the Configuration section of README.md.
%% Settings in etodo.toml take priority over the ones below.
[
    {eTodo,  [{mode, "gui"},    %% gui | noGui

              %% JIRA plugin defaults
              {jiraUrl,    "http://JIRA:8080"},
              {jiraUser,   ""},
              {jiraPwd,    ""},
              {jiraSearch, "assignee = currentUser() and status not in (Resolved, Closed)"}]}
].
