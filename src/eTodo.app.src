{application, eTodo,
 [{description, "ETodo a task manager written in Erlang"},
  {vsn, "1.0.1"},
  {modules, [
	     eLang,
	     eGuiEvents,
	     eGuiFunctions,
	     eHtml,
	     ePeer,
	     ePeerCircle,
	     ePeerCircleEH,
	     ePeerEH,
	     ePeerEM,
	     ePeerLock,
	     ePeerLockEH,
	     ePeerProtocol,
	     ePeerServer,
	     ePlugin,
	     ePluginServer,
             eRows,
	     eRows_lists,
	     eTodo,
	     eTodoAPI,
	     eWorkLogView,
	     eTodoAlarm,
	     eTodoDB,
	     eTodoMistAuth,
	     eTodoEH,
	     eTodoSup,
	     eTodoUtils,
	     eTodoMist,
	     eTodoStatus,
	     eTodoTunnel,
	     eTodoApp,
	     eTodoConfig,
	     startETodo
	    ]},
  {maxT, infinity},
  {registered, [
	        eLang,
		ePeerCircle,
		ePeerEM,
		ePeerLock,
		ePeerServer,
		eTodo,
		eTodoAlarm,
		eTodoDB,
		eTodoMistAuth,
		eTodoSup,
		ePluginServer
	       ]},
	{applications, [kernel, stdlib, compiler, sasl, mnesia, inets, crypto, asn1, public_key, ssl, wx, jsx, mochiweb, gun, eLog, ePort, etodo_web]},
  {included_applications, []},
  {env, []},
  {mod, {eTodoApp, []}
  }
 ]
}.
