                      <object class="sizeritem">
                        <flag>wxALIGN_CENTER_VERTICAL|wxALL</flag>
                        <border>5</border>
                        <option>0</option>
                        <object class="wxCheckBox" name="teamPom">
                          <size>100,-1</size>
                          <label>Team clock:</label>
                          <checked>0</checked>
                        </object>
                      </object>
                    </object>
                  </object>
                  <object class="sizeritem">
                    <flag>wxEXPAND</flag>
                    <border>5</border>
                    <option>4</option>
                    <object class="wxBoxSizer" name="bSizer176">
                      <orient>wxHORIZONTAL</orient>
                      <object class="sizeritem">
                        <flag>wxALL</flag>
                        <border>5</border>
                        <option>0</option>
                        <object class="wxSpinCtrl" name="hourTimer">
                          <size>70,-1</size>
                          <style>wxSP_ARROW_KEYS|wxSP_WRAP</style>
                          <tooltip>Hours</tooltip>
                          <value>0</value>
                          <min>0</min>
                          <max>23</max>
                        </object>
                      </object>
                      <object class="sizeritem">
                        <flag>wxALL</flag>
                        <border>5</border>
                        <option>0</option>
                        <object class="wxSpinCtrl" name="minTimer">
                          <size>70,-1</size>
                          <style>wxSP_ARROW_KEYS|wxSP_WRAP</style>
                          <tooltip>Minutes</tooltip>
                          <value>25</value>
                          <min>0</min>
                          <max>60</max>
                        </object>
                      </object>
                      <object class="sizeritem">
                        <flag>wxALL</flag>
                        <border>5</border>
                        <option>0</option>
                        <object class="wxSpinCtrl" name="secTimer">
                          <size>70,-1</size>
                          <style>wxSP_ARROW_KEYS|wxSP_WRAP</style>
                          <tooltip>Seconds</tooltip>
                          <value>0</value>
                          <min>0</min>
                          <max>60</max>
                        </object>
                      </object>
                    </object>
                  </object>
                </object>
              </object>
              <object class="sizeritem">
                <flag>wxEXPAND</flag>
                <border>5</border>
                <option>0</option>
                <object class="wxBoxSizer" name="bSizer161">
                  <orient>wxHORIZONTAL</orient>
                  <object class="sizeritem">
                    <flag>wxEXPAND</flag>
                    <border>5</border>
                    <option>2</option>
                    <object class="wxBoxSizer" name="bSizer162">
                      <orient>wxHORIZONTAL</orient>
                      <object class="spacer">
                        <flag>wxEXPAND</flag>
                        <border>5</border>
                        <option>1</option>
                        <size>0,0</size>
                      </object>
                      <object class="sizeritem">
                        <flag>wxALIGN_CENTER_VERTICAL|wxALL</flag>
                        <border>5</border>
                        <option>0</option>
                        <object class="wxCheckBox" name="executeTimCmd">
                          <size>100,-1</size>
                          <label>Execute cmd:</label>
                          <checked>0</checked>
                        </object>
                      </object>
                    </object>
                  </object>
                  <object class="sizeritem">
                    <flag>wxALL</flag>
                    <border>5</border>
                    <option>4</option>
                    <object class="wxTextCtrl" name="execTimCmd">
                      <tooltip>Run entered command when the timer occurs(can be used to play a sound)</tooltip>
                      <value></value>
                      <maxlength>0</maxlength>
                    </object>
                  </object>
                </object>
              </object>
              <object class="sizeritem">
                <flag>wxEXPAND</flag>
                <border>5</border>
                <option>1</option>
                <object class="wxBoxSizer" name="bSizer163">
                  <orient>wxHORIZONTAL</orient>
                  <object class="sizeritem">
                    <flag>wxEXPAND</flag>
                    <border>5</border>
                    <option>2</option>
                    <object class="wxBoxSizer" name="bSizer164">
                      <orient>wxHORIZONTAL</orient>
                      <object class="spacer">
                        <flag>wxEXPAND</flag>
                        <border>5</border>
                        <option>1</option>
                        <size>0,0</size>
                      </object>
                      <object class="sizeritem">
                        <flag>wxALIGN_CENTER_VERTICAL|wxALL</flag>
                        <border>5</border>
                        <option>0</option>
                        <object class="wxStaticText" name="m_staticText45">
                          <size>80,-1</size>
                          <label>Description:</label>
                          <wrap>-1</wrap>
                        </object>
                      </object>
                    </object>
                  </object>
                  <object class="sizeritem">
                    <flag>wxALL</flag>
                    <border>5</border>
                    <option>4</option>
                    <object class="wxTextCtrl" name="timerDesc">
                      <value>Break time (Pomodoro)</value>
                      <maxlength>0</maxlength>
                    </object>
                  </object>
                </object>
              </object>
            </object>
          </object>
        </object>
      </object>
      <object class="sizeritem">
        <flag>wxEXPAND</flag>
        <border>5</border>
        <option>0</option>
        <object class="wxBoxSizer" name="bSizer165">
          <orient>wxVERTICAL</orient>
          <object class="sizeritem">
            <flag>wxEXPAND</flag>
            <border>5</border>
            <option>0</option>
            <object class="wxBoxSizer" name="bSizer166">
              <orient>wxHORIZONTAL</orient>
              <object class="spacer">
                <flag>wxEXPAND</flag>
                <border>5</border>
                <option>1</option>
                <size>0,0</size>
              </object>
              <object class="sizeritem">
                <flag>wxALL</flag>
                <border>5</border>
                <option>0</option>
                <object class="wxButton" name="timerOk">
                  <label>OK</label>
                  <default>1</default>
                  <auth_needed>0</auth_needed>
                  <markup>0</markup>
                  <bitmap/>
                </object>
              </object>
              <object class="sizeritem">
                <flag>wxALL</flag>
                <border>5</border>
                <option>0</option>
                <object class="wxButton" name="timerCancel">
                  <label>Cancel</label>
                  <default>0</default>
                  <auth_needed>0</auth_needed>
                  <markup>0</markup>
                  <bitmap/>
                </object>
              </object>
            </object>
          </object>
        </object>
      </object>
    </object>
  </object>
  <object class="wxDialog" name="pluginDlg">
    <style>wxDEFAULT_DIALOG_STYLE|wxRESIZE_BORDER</style>
    <title>Plugin configuration</title>
    <object class="wxBoxSizer" name="bSizer167">
      <orient>wxVERTICAL</orient>
      <object class="sizeritem">
        <flag>wxEXPAND</flag>
        <border>5</border>
        <option>1</option>
        <object class="wxBoxSizer" name="bSizer168">
          <orient>wxHORIZONTAL</orient>
          <object class="sizeritem">
            <flag>wxALL</flag>
            <border>10</border>
            <option>0</option>
            <object class="wxStaticBitmap" name="m_bitmap6">
              <bitmap>./Icons/plugin.png</bitmap>
            </object>
          </object>
          <object class="sizeritem">
            <flag>wxEXPAND</flag>
            <border>5</border>
            <option>1</option>
            <object class="wxBoxSizer" name="bSizer169">
              <orient>wxVERTICAL</orient>
              <object class="sizeritem">
                <flag>wxALL|wxEXPAND</flag>
                <border>5</border>
                <option>1</option>
                <object class="wxSplitterWindow" name="m_splitter7">
                  <style>wxSP_3D</style>
                  <sashpos>180</sashpos>
                  <gravity>0</gravity>
                  <minsize>0</minsize>
                  <orientation>vertical</orientation>
                  <object class="wxPanel" name="m_panel23">
                    <style>wxTAB_TRAVERSAL</style>
                    <object class="wxBoxSizer" name="bSizer170">
                      <orient>wxVERTICAL</orient>
                      <object class="sizeritem">
                        <flag>wxALL|wxEXPAND</flag>
                        <border>5</border>
                        <option>1</option>
                        <object class="wxCheckListBox" name="usePlugins">
                          <size>180,200</size>
                          <style>wxLB_SORT|wxBORDER_SIMPLE</style>
                          <content/>
                        </object>
                      </object>
                    </object>
                  </object>
                  <object class="wxPanel" name="m_panel24">
                    <style>wxTAB_TRAVERSAL</style>
                    <object class="wxStaticBoxSizer" name="sbSizer8">
                      <orient>wxVERTICAL</orient>
                      <label>Description</label>
                      <object class="sizeritem">
                        <flag>wxALL|wxEXPAND</flag>
                        <border>5</border>
                        <option>0</option>
                        <object class="wxStaticText" name="pluginDesc">
                          <label>A longer description of the plugin which appears when the plugin is selected in the list above.</label>
                          <wrap>180</wrap>
                        </object>
                      </object>
                    </object>
                  </object>
                </object>
              </object>
              <object class="sizeritem">
                <flag>wxEXPAND</flag>
                <border>5</border>
                <option>0</option>
                <object class="wxBoxSizer" name="bSizer171">
                  <orient>wxHORIZONTAL</orient>
                  <object class="spacer">
                    <flag>wxEXPAND</flag>
                    <border>5</border>
                    <option>1</option>
                    <size>0,0</size>
                  </object>
                  <object class="sizeritem">
                    <flag>wxALL</flag>
                    <border>5</border>
                    <option>0</option>
                    <object class="wxButton" name="pluginOk">
                      <label>OK</label>
                      <default>1</default>
                      <auth_needed>0</auth_needed>
                      <markup>0</markup>
                      <bitmap/>
                    </object>
                  </object>
                  <object class="sizeritem">
                    <flag>wxALL</flag>
                    <border>5</border>
                    <option>0</option>
                    <object class="wxButton" name="pluginCancel">
                      <label>Cancel</label>
                      <default>0</default>
                      <auth_needed>0</auth_needed>
                      <markup>0</markup>
                      <bitmap/>
                    </object>
                  </object>
                </object>
              </object>
            </object>
          </object>
        </object>
      </object>
    </object>
  </object>
</resource>
