<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<resource xmlns="http://www.wxwidgets.org/wxxrc" version="2.5.3.0">
  <object class="wxFrame" name="mainFrame">
    <size>850,750</size>
    <style>wxDEFAULT_FRAME_STYLE|wxSYSTEM_MENU</style>
    <title>ETodo</title>
    <aui_managed>0</aui_managed>
    <object class="wxMenuBar" name="menubar">
      <object class="wxMenu" name="fileMenu">
        <label>File</label>
        <object class="wxMenuItem" name="loginMenuItem">
          <label>Login</label>
          <accel>Ctrl+L</accel>
          <help></help>
          <bitmap>./Icons/login.png</bitmap>
        </object>
        <object class="wxMenuItem" name="logoutMenuItem">
          <label>Logout</label>
          <accel></accel>
          <help></help>
          <bitmap>./Icons/logout.png</bitmap>
        </object>
        <object class="separator"/>
        <object class="wxMenuItem" name="backupMenuItem">
          <label>Backup database</label>
          <accel></accel>
          <help></help>
          <bitmap>./Icons/database.png</bitmap>
        </object>
        <object class="wxMenuItem" name="restoreMenuItem">
          <label>Restore database</label>
          <accel></accel>
          <help></help>
          <bitmap>./Icons/database.png</bitmap>
        </object>
        <object class="separator"/>
        <object class="wxMenuItem" name="pluginMenuItem">
          <label>Plugins</label>
          <accel></accel>
          <help></help>
          <bitmap>./Icons/plugin-small.png</bitmap>
        </object>
        <object class="separator"/>
        <object class="wxMenuItem" name="printMenuItem">
          <label>Print</label>
          <accel>Ctrl+P</accel>
          <help></help>
          <bitmap>./Icons/print.png</bitmap>
        </object>
        <object class="separator"/>
        <object class="wxMenuItem" name="setAvatarMenuItem">
          <label>Set avatar</label>
          <accel></accel>
          <help>Set avatar used in chat.</help>
          <bitmap>./Icons/avatar.png</bitmap>
        </object>
        <object class="separator"/>
        <object class="wxMenuItem" name="exitMenuItem">
          <label>Exit</label>
          <accel>Alt+F4</accel>
          <help></help>
          <bitmap>./Icons/exit.png</bitmap>
        </object>
      </object>
      <object class="wxMenu" name="editMenu">
        <label>Edit</label>
        <object class="wxMenuItem" name="cutMenu">
          <label>Cut task</label>
          <accel>Shift+Ctrl+X</accel>
          <help></help>
          <bitmap>./Icons/cut-small.png</bitmap>
        </object>
        <object class="wxMenuItem" name="copyMenu">
          <label>Copy task</label>
          <accel>Shift+Ctrl+C</accel>
          <help></help>
          <bitmap>./Icons/copy-small.png</bitmap>
        </object>
        <object class="wxMenuItem" name="pasteMenu">
          <label>Paste task</label>
          <accel>Shift+Ctrl+V</accel>
          <help></help>
          <bitmap>./Icons/paste-small.png</bitmap>
        </object>
        <object class="wxMenuItem" name="deleteMenu">
          <label>Delete task</label>
          <accel>Shift+Ctrl+D</accel>
          <help></help>
          <bitmap>./Icons/delete-small.png</bitmap>
        </object>
        <object class="separator"/>
        <object class="wxMenuItem" name="addTaskMenu">
          <label>Add task at bottom</label>
          <accel>Ctrl+N</accel>
          <help></help>
          <bitmap>./Icons/addTaskMenu.png</bitmap>
        </object>
        <object class="wxMenuItem" name="addTaskInboxMenu">
          <label>Add task to inbox</label>
          <accel>Ctrl+Shift+N</accel>
          <help></help>
          <bitmap>./Icons/addTaskMenu.png</bitmap>
        </object>
        <object class="separator"/>
        <object class="wxMenuItem" name="moveFirstMenu">
          <label>Move first</label>
          <accel>Ctrl+Q</accel>
          <help></help>
          <bitmap>./Icons/moveUp.png</bitmap>
        </object>
        <object class="wxMenuItem" name="moveUpMenu">
          <label>Move up</label>
          <accel>Alt+Q</accel>
          <help></help>
          <bitmap>./Icons/moveUp.png</bitmap>
        </object>
        <object class="wxMenuItem" name="moveDownMenu">
          <label>Move down</label>
          <accel>Alt+&lt;</accel>
          <help></help>
          <bitmap>./Icons/moveDown.png</bitmap>
        </object>
        <object class="wxMenuItem" name="moveLastMenu">
          <label>Move last</label>
          <accel>Ctrl+&lt;</accel>
          <help></help>
          <bitmap>./Icons/moveDown.png</bitmap>
        </object>
        <object class="separator"/>
        <object class="wxMenuItem" name="undoMenu">
          <label>Undo</label>
          <accel>Ctrl+Z</accel>
          <help></help>
          <bitmap>./Icons/undo-small.png</bitmap>
        </object>
        <object class="wxMenuItem" name="redoMenu">
          <label>Redo</label>
          <accel>Ctrl+Y</accel>
          <help></help>
          <bitmap>./Icons/redo-small.png</bitmap>
        </object>
        <object class="separator"/>
        <object class="wxMenuItem" name="settingsMenu">
          <label>Settings</label>
          <accel></accel>
          <help>Enter peer information needed to connect to other circles.</help>
          <bitmap>./Icons/network-small.png</bitmap>
        </object>
      </object>
      <object class="wxMenu" name="viewMenu">
        <label>View</label>
        <object class="wxMenuItem" name="linkFileMenu">
          <label>Link to file</label>
          <accel>Ctrl+I</accel>
          <help></help>
          <bitmap>./Icons/link.png</bitmap>
        </object>
        <object class="wxMenuItem" name="linkViewMenu">
          <label>Link to view</label>
          <accel></accel>
          <help></help>
          <bitmap>./Icons/link.png</bitmap>
        </object>
        <object class="wxMenuItem" name="linkTimeReportMenu">
          <label>Link to time report</label>
          <accel></accel>
          <help></help>
          <bitmap>./Icons/link.png</bitmap>
        </object>
        <object class="wxMenuItem" name="proxyLinkMenu">
          <label>Make proxy link</label>
          <accel></accel>
          <help></help>
          <bitmap>./Icons/link.png</bitmap>
        </object>
        <object class="separator"/>
        <object class="wxMenuItem" name="replyMenu">
          <label>Reply sender</label>
          <accel>Ctrl+R</accel>
          <help>Reply to last incoming message</help>
          <bitmap>./Icons/reply.png</bitmap>
        </object>
        <object class="wxMenuItem" name="replyAllMenu">
          <label>Reply all</label>
          <accel>Shift+Ctrl+R</accel>
          <help>Reply all</help>
          <bitmap>./Icons/replyAll.png</bitmap>
        </object>
        <object class="wxMenuItem" name="sendChatMenu">
          <label>Send chat</label>
          <accel>Enter</accel>
          <help>Send chat</help>
          <bitmap>./Icons/send.png</bitmap>
          <enabled>0</enabled>
        </object>
        <object class="separator"/>
        <object class="wxMenuItem" name="toggleFilterMenuItem">
          <label>Toggle filter messages</label>
          <accel>Alt+F</accel>
          <help>Toggle filter messages.</help>
        </object>
        <object class="wxMenuItem" name="toggleDetailsMenuItem">
          <label>Show task details</label>
          <accel>Ctrl+D</accel>
          <help>Show or hide the task details below the task list.</help>
          <checkable>1</checkable>
          <checked>1</checked>
        </object>
        <object class="wxMenuItem" name="openTaskDetailsMenuItem">
          <label>Open task details in window</label>
          <accel>Alt+Ctrl+D</accel>
          <help>Open the task details in a separate resizable window.</help>
        </object>
        <object class="separator"/>
      </object>
      <object class="wxMenu" name="helpMenu">
        <label>Help</label>
        <object class="wxMenuItem" name="updateMenu">
          <label>Create update link</label>
          <accel>Ctrl+U</accel>
          <help></help>
          <bitmap>Icons/link.png</bitmap>
        </object>
        <object class="separator"/>
        <object class="wxMenuItem" name="helpMenu1">
          <label>Help</label>
          <accel>F1</accel>
          <help></help>
          <bitmap>./Icons/help.png</bitmap>
        </object>
        <object class="wxMenuItem" name="aboutMenu">
          <label>About</label>
          <accel></accel>
          <help></help>
          <bitmap>./Icons/about-small.png</bitmap>
        </object>
      </object>
    </object>
    <object class="wxToolBar" name="eTodoToolbar">
      <style>wxTB_HORIZONTAL</style>
      <bitmapsize></bitmapsize>
      <margins></margins>
      <packing>1</packing>
      <separation>5</separation>
      <object class="tool" name="todoUpTool">
        <label>Add at top</label>
        <tooltip>Add at top</tooltip>
        <longhelp>Add task at top of list</longhelp>
        <bitmap>./Icons/todoAddTop.png</bitmap>
      </object>
      <object class="tool" name="todoDownTool">
        <label>Add at bottom</label>
        <tooltip>Add at bottom</tooltip>
        <longhelp>Add task at bottom of list</longhelp>
        <bitmap>./Icons/todoAddBottom.png</bitmap>
      </object>
      <object class="separator"/>
      <object class="tool" name="moveUpTool">
        <label>Move up</label>
        <tooltip>Move up</tooltip>
        <longhelp>Move task up in list</longhelp>
        <bitmap>./Icons/sortAscending.png</bitmap>
      </object>
      <object class="tool" name="moveDownTool">
        <label>Move Down</label>
        <tooltip>Move down</tooltip>
        <longhelp>Move task down in list</longhelp>
        <bitmap>./Icons/sortDecending.png</bitmap>
      </object>
      <object class="tool" name="backTool">
        <label>Back</label>
        <tooltip>Go back</tooltip>
        <longhelp>Go back to parent todo</longhelp>
        <bitmap>./Icons/back.png</bitmap>
      </object>
      <object class="tool" name="forwardTool">
        <label>Forward</label>
        <tooltip>Go to sub todo</tooltip>
        <longhelp>Go to sub todo</longhelp>
        <bitmap>./Icons/forward.png</bitmap>
      </object>
      <object class="separator"/>
      <object class="tool" name="cutTool">
        <label>Cut</label>
        <tooltip>Cut</tooltip>
        <longhelp>Cut task</longhelp>
        <bitmap>./Icons/edit-cut.png</bitmap>
      </object>
      <object class="tool" name="copyTool">
        <label>Copy</label>
        <tooltip>Copy</tooltip>
        <longhelp>Copy task</longhelp>
        <bitmap>./Icons/edit-copy.png</bitmap>
      </object>
      <object class="tool" name="pasteTool">
        <label>Paste</label>
        <tooltip>Paste</tooltip>
        <longhelp>Paste task</longhelp>
        <bitmap>./Icons/edit-paste.png</bitmap>
      </object>
      <object class="tool" name="deleteTool">
        <label>Delete</label>
        <tooltip>Delete</tooltip>
        <longhelp>Delete task</longhelp>
        <bitmap>./Icons/edit-delete.png</bitmap>
      </object>
      <object class="separator"/>
      <object class="tool" name="timerTool">
        <label>Timer</label>
        <tooltip></tooltip>
        <longhelp></longhelp>
        <bitmap>./Icons/timer.png</bitmap>
      </object>
      <object class="separator"/>
      <object class="tool" name="undoTool">
        <label>Undo</label>
        <tooltip>Undo</tooltip>
        <longhelp>Undo changes to tasks</longhelp>
        <bitmap>./Icons/edit-undo.png</bitmap>
      </object>
      <object class="tool" name="redoTool">
        <label>Redo</label>
        <tooltip>Redo</tooltip>
        <longhelp>Redo changes to tasks</longhelp>
        <bitmap>./Icons/edit-redo.png</bitmap>
      </object>
    </object>
    <object class="wxStatusBar" name="mainStatusBar">
      <style>wxSTB_SIZEGRIP</style>
      <fields>4</fields>
    </object>
    <object class="wxNotebook" name="mainNotebook">
      <object class="notebookpage">
        <label>Task view</label>
        <selected>1</selected>
        <object class="wxPanel" name="mainPanel">
          <object class="wxBoxSizer" name="bSizer2">
            <orient>wxVERTICAL</orient>
            <object class="sizeritem">
              <flag>wxEXPAND</flag>
              <border>5</border>
              <option>0</option>
              <object class="wxBoxSizer" name="bSizer3">
                <orient>wxHORIZONTAL</orient>
                <object class="sizeritem">
                  <flag>wxEXPAND</flag>
                  <border>5</border>
                  <option>1</option>
                  <object class="wxBoxSizer" name="bSizer4">
                    <orient>wxHORIZONTAL</orient>
                    <object class="sizeritem">
                      <flag>wxALIGN_CENTER_VERTICAL|wxALL</flag>
                      <border>5</border>
                      <option>0</option>
                      <object class="wxBitmapButton" name="manageListsButton">
                        <tooltip>Manage lists</tooltip>
                        <default>0</default>
                        <auth_needed>0</auth_needed>
                        <bitmap>./Icons/list.png</bitmap>
                      </object>
                    </object>
                    <object class="sizeritem">
                      <flag>wxALIGN_CENTER_VERTICAL|wxALL</flag>
                      <border>5</border>
                      <option>0</option>
                      <object class="wxStaticText" name="chooseListLang">
                        <label>Choose list:</label>
                        <wrap>-1</wrap>
                      </object>
                    </object>
                    <object class="sizeritem">
                      <flag>wxALIGN_CENTER_VERTICAL|wxALL</flag>
                      <border>5</border>
                      <option>0</option>
                      <object class="wxChoice" name="taskListChoice">
                        <size>175,-1</size>
                        <selection>0</selection>
                        <content>
                          <item>All tasks</item>
                        </content>
                      </object>
                    </object>
                    <object class="sizeritem">
                      <flag>wxALIGN_CENTER_VERTICAL|wxALL</flag>
                      <border>5</border>
                      <option>0</option>
                      <object class="wxCheckBox" name="checkBoxUseFilter">
                        <enabled>0</enabled>
                        <tooltip>Use configured filter</tooltip>
                        <label>Filter</label>
                        <checked>1</checked>
                      </object>
                    </object>
                    <object class="sizeritem">
                      <flag>wxALIGN_CENTER_VERTICAL|wxALL</flag>
                      <border>5</border>
                      <option>0</option>
                      <object class="wxStaticBitmap" name="infoIcon">
                        <hidden>1</hidden>
                        <bitmap>./Icons/about-small.png</bitmap>
                      </object>
                    </object>
                  </object>
                </object>
                <object class="sizeritem">
                  <flag>wxEXPAND</flag>
                  <border>5</border>
                  <option>1</option>
                  <object class="wxBoxSizer" name="bSizer5">
                    <orient>wxHORIZONTAL</orient>
                    <object class="sizeritem">
                      <flag>wxALIGN_CENTER_VERTICAL|wxALL</flag>
                      <border>5</border>
                      <option>0</option>
                      <object class="wxBitmapButton" name="configureSearch">
                        <tooltip>Configure which fields to search in</tooltip>
                        <default>0</default>
                        <auth_needed>0</auth_needed>
                        <bitmap>./Icons/search.png</bitmap>
                      </object>
                    </object>
                    <object class="sizeritem">
                      <flag>wxALIGN_CENTER_VERTICAL|wxALL</flag>
                      <border>5</border>
                      <option>1</option>
                      <object class="wxComboBox" name="searchText">
                        <style>wxTE_PROCESS_ENTER</style>
                        <tooltip>Enter search. Searches begining with re~ will trigger a regexp search. Searches begining with as~ will trigger an advanced search.</tooltip>
                        <value></value>
                        <content/>
                      </object>
                    </object>
                    <object class="sizeritem">
                      <flag>wxALIGN_CENTER_VERTICAL|wxALL</flag>
                      <border>5</border>
                      <option>0</option>
                      <object class="wxBitmapButton" name="bookmarkBtn">
                        <tooltip>Bookmark view</tooltip>
                        <default>0</default>
                        <auth_needed>0</auth_needed>
                        <bitmap>./Icons/bookmark.png</bitmap>
                      </object>
                    </object>
                  </object>
                </object>
              </object>
            </object>
            <object class="sizeritem">
              <flag>wxEXPAND|wxALL</flag>
              <border>5</border>
              <option>1</option>
              <object class="wxPanel" name="taskListPanel">
                <style>wxBORDER_NONE</style>
                <object class="wxBoxSizer" name="bSizer6">
                  <orient>wxVERTICAL</orient>
                  <object class="sizeritem">
                    <flag>wxEXPAND</flag>
                    <border>5</border>
                    <option>1</option>
                    <object class="wxPanel" name="taskSplitPanel">
                      <style>wxBORDER_NONE</style>
                      <object class="wxBoxSizer" name="taskSplitPanelSizer">
                        <orient>wxVERTICAL</orient>
                        <object class="sizeritem">
                          <flag>wxEXPAND</flag>
                          <border>0</border>
                          <option>1</option>
                          <object class="wxPanel" name="m_panel12">
                            <style>wxTAB_TRAVERSAL</style>
                            <object class="wxBoxSizer" name="bSizer7">
                              <orient>wxHORIZONTAL</orient>
                              <object class="sizeritem">
                                <flag>wxEXPAND|wxALL</flag>
                                <border>5</border>
                                <option>1</option>
                                <object class="wxPanel" name="mainTaskPanel">
                                  <object class="wxBoxSizer" name="bSizer8">
                                    <orient>wxVERTICAL</orient>
                                    <object class="sizeritem">
                                      <flag>wxALL|wxEXPAND</flag>
                                      <border>5</border>
                                      <option>1</option>
                                      <object class="wxListCtrl" name="mainTaskList">
                                        <style>wxLC_REPORT|wxLC_SINGLE_SEL|wxBORDER_NONE</style>
                                      </object>
                                    </object>
                                  </object>
                                </object>
                              </object>
                            </object>
                          </object>
                        </object>
                        <object class="sizeritem">
                          <flag>wxEXPAND</flag>
                          <border>0</border>
                          <option>0</option>
                          <object class="wxPanel" name="taskEditPanel">
                            <style>wxTAB_TRAVERSAL</style>
                            <object class="wxBoxSizer" name="bSizer9">
                              <orient>wxVERTICAL</orient>
                              <object class="sizeritem">
                                <flag>wxEXPAND</flag>
                                <border>5</border>
                                <option>0</option>
                                <object class="wxBoxSizer" name="bSizer10">
                                  <orient>wxHORIZONTAL</orient>
                                  <object class="sizeritem">
                                    <flag>wxEXPAND</flag>
                                    <border>0</border>
                                    <option>1</option>
                                    <object class="wxBoxSizer" name="bSizer11">
                                      <orient>wxHORIZONTAL</orient>
                                      <object class="sizeritem">
                                        <flag>wxALIGN_CENTER_VERTICAL|wxALL</flag>
                                        <border>10</border>
                                        <option>0</option>
                                        <object class="wxStaticBitmap" name="planning">
                                          <bitmap>./Icons/planning.png</bitmap>
                                        </object>
                                      </object>
                                      <object class="sizeritem">
                                        <flag>wxALIGN_CENTER_VERTICAL|wxALL</flag>
                                        <border>5</border>
                                        <option>0</option>
                                        <object class="wxStaticText" name="statusLang">
                                          <label>Status:</label>
                                          <wrap>-1</wrap>
                                        </object>
                                      </object>
                                      <object class="sizeritem">
                                        <flag>wxALIGN_CENTER_VERTICAL|wxALL</flag>
                                        <border>5</border>
                                        <option>1</option>
                                        <object class="wxChoice" name="statusChoice">
                                          <selection>0</selection>
                                          <content>
                                            <item>N/A</item>
                                            <item>Planning</item>
                                            <item>In progress</item>
                                            <item>Done</item>
                                          </content>
                                        </object>
                                      </object>
                                    </object>
                                  </object>
                                  <object class="sizeritem">
                                    <flag>wxEXPAND</flag>
                                    <border>0</border>
                                    <option>1</option>
                                    <object class="wxBoxSizer" name="bSizer12">
                                      <orient>wxHORIZONTAL</orient>
                                      <object class="sizeritem">
                                        <flag>wxALIGN_CENTER_VERTICAL|wxALL</flag>
                                        <border>10</border>
                                        <option>0</option>
                                        <object class="wxStaticBitmap" name="priority">
                                          <bitmap>./Icons/prio.png</bitmap>
                                        </object>
                                      </object>
                                      <object class="sizeritem">
                                        <flag>wxALIGN_CENTER_VERTICAL|wxALL</flag>
                                        <border>5</border>
                                        <option>0</option>
                                        <object class="wxStaticText" name="priorityLang">
                                          <label>Priority:</label>
                                          <wrap>-1</wrap>
                                        </object>
                                      </object>
                                      <object class="sizeritem">
                                        <flag>wxALIGN_CENTER_VERTICAL|wxALL</flag>
                                        <border>5</border>
                                        <option>1</option>
                                        <object class="wxChoice" name="priorityChoice">
                                          <selection>0</selection>
                                          <content>
                                            <item>N/A</item>
                                            <item>Low</item>
                                            <item>Medium</item>
                                            <item>High</item>
                                          </content>
                                        </object>
                                      </object>
                                    </object>
                                  </object>
                                  <object class="sizeritem">
                                    <flag>wxEXPAND</flag>
                                    <border>5</border>
                                    <option>1</option>
                                    <object class="wxBoxSizer" name="bSizer13">
                                      <orient>wxHORIZONTAL</orient>
                                      <object class="sizeritem">
                                        <flag>wxALIGN_CENTER_VERTICAL|wxALL</flag>
                                        <border>5</border>
                                        <option>0</option>
                                        <object class="wxBitmapButton" name="setReminderButton">
                                          <tooltip>Set reminder for task</tooltip>
                                          <default>0</default>
                                          <auth_needed>0</auth_needed>
                                          <bitmap>./Icons/task-due.png</bitmap>
                                        </object>
                                      </object>
                                      <object class="sizeritem">
                                        <flag>wxALIGN_CENTER_VERTICAL|wxALL</flag>
                                        <border>5</border>
                                        <option>0</option>
                                        <object class="wxStaticText" name="dueDateLang">
                                          <label>Due date:</label>
                                          <wrap>-1</wrap>
                                        </object>
                                      </object>
                                      <object class="sizeritem">
                                        <flag>wxALIGN_CENTER_VERTICAL|wxALL</flag>
                                        <border>5</border>
                                        <option>1</option>
                                        <object class="wxDatePickerCtrl" name="dueDatePicker">
                                          <style>wxDP_DROPDOWN</style>
                                        </object>
                                      </object>
                                      <object class="sizeritem">
                                        <flag>wxALIGN_CENTER_VERTICAL|wxALL</flag>
                                        <border>1</border>
                                        <option>0</option>
                                        <object class="wxCheckBox" name="dueDateUsed">
                                          <tooltip>Use due date</tooltip>
                                          <label></label>
                                          <checked>0</checked>
                                        </object>
                                      </object>
                                    </object>
                                  </object>
                                </object>
                              </object>
                              <object class="sizeritem">
                                <flag>wxEXPAND</flag>
                                <border>5</border>
                                <option>1</option>
                                <object class="wxPanel" name="taskTextPanel">
                                  <size>-1,220</size>
                                  <style>wxBORDER_NONE</style>
                                  <object class="wxBoxSizer" name="taskTextPanelSizer">
                                    <orient>wxHORIZONTAL</orient>
                                    <object class="sizeritem">
                                      <flag>wxEXPAND</flag>
                                      <border>0</border>
                                      <option>1</option>
                                      <object class="wxPanel" name="m_panel14">
                                        <style>wxBORDER_NONE</style>
                                        <object class="wxBoxSizer" name="bSizer14">
                                          <orient>wxVERTICAL</orient>
                                          <object class="sizeritem">
                                            <flag>wxEXPAND | wxALL</flag>
                                            <border>5</border>
                                            <option>1</option>
                                            <object class="wxNotebook" name="descNotebook">
                                              <object class="notebookpage">
                                                <label>Text</label>
                                                <selected>0</selected>
                                                <object class="wxPanel" name="descTextPanel">
                                                  <style>wxTAB_TRAVERSAL</style>
