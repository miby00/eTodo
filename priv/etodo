#!/bin/sh
#
# etodo
#

# chkconfig: 2345 85 15
# description: eTodo is a task manager written in Erlang
# processname: beam
#

# Source function library.
. /lib/lsb/init-functions
# . /etc/rc.d/init.d/functions

NAME=etodo
DESC="eTodo is a task manager written in Erlang"

lockfile=/var/lock/subsys/$NAME
binpath=/usr/lib/eTodo/bin
# /etc/default/etodo (readable by etodo only) may set ETODO_CONFIG and the
# secrets that etodo.toml refers to as "%NAME%".
startcommand="set -a; [ -r /etc/default/etodo ] && . /etc/default/etodo; set +a; DISPLAY=:99 $binpath/eTodo start"
stopcommand="$binpath/eTodo stop"
connectcommand="$binpath/eTodo attach"

relroot=${binpath%/bin}

# Fallbacks for systems without the RedHat function library.
type success >/dev/null 2>&1 || success() { echo " [ OK ]"; }
type failure >/dev/null 2>&1 || failure() { echo " [FAILED]"; }

RETVAL=0

# Check for installed files
[ -d $binpath ] || exit 0

# The VM of this release is recognized by the release directory in its command
# line (-root, -boot), the node name or user name are not part of it. If that
# finds nothing, ask the node itself.
beam_pids() {
    pids=$(ps -eo pid=,args= | grep "beam" | grep -F -- "$relroot/" |
               grep -v grep | awk '{print $1}')
    if [ "$pids" = "" ]; then
        pids=$(su - etodo -c "$binpath/eTodo pid" 2>/dev/null |
                   grep -E '^[0-9]+$')
    fi
    echo "$pids"
}

check_pid_status() {
    pid=$(beam_pids)
    if [ "$pid" = "" ]; then
        # prog not running?
        return 1
    else
        # running
        return 0
    fi
}

start() {
    # Start daemons.
    echo -n $"Starting eTodo: "

    # The start command waits until the node answers; when the node fails
    # to boot (for example a bad etodo.toml) it would wait forever.
    timeout 120 su - etodo -c "$startcommand"

    RETVAL=$?
    if [ $RETVAL -eq 0 ]; then
        touch $lockfile
        success
    else
        failure $"$NAME start"
        echo
        echo "eTodo did not start. See $relroot/log/erlang.log.* or run:"
        echo "  sudo -u etodo sh -c 'set -a; . /etc/default/etodo; $binpath/eTodo foreground'"
    fi
    echo
    return $RETVAL
}

stop() {
    # Stop daemon.
    echo -n $"Shutting down eTodo: "
    su - etodo -c "killall to_erl >/dev/null 2>&1"
    su - etodo -c "$stopcommand >/dev/null 2>&1"
    for n in $(seq 1 30); do
        sleep 1
        check_pid_status
        RETVAL=$?
        if [ $RETVAL -eq 1 ]; then
            break
        fi
    done
    if [ $RETVAL -ne 1 ]; then
        # The node did not stop in time, kill it.
        beam_pids | xargs -r kill -9
        sleep 1
        check_pid_status
        RETVAL=$?
    fi
    if [ $RETVAL -eq 1 ]; then
        rm -f $lockfile
        rm -rf /tmp/erl_pipes/eTodo@*
        RETVAL=0
        success
    else
        RETVAL=1
        failure $"$NAME stop"
    fi
    echo
    return $RETVAL
}

hardstop() {
    echo -n $"Shutting down $NAME: "
    beam_pids | xargs -r kill -9
    for n in $(seq 1 10); do
        sleep 1
        check_pid_status
        RETVAL=$?
        if [ $RETVAL -eq 1 ]; then
            break
        fi
    done
    if [ $RETVAL -eq 1 ]; then
        rm -f $lockfile
        success
    else
        failure $"$NAME hardstop"
    fi
    echo
    return $RETVAL
}

connect() {
    # Stop daemon.
    su - etodo -c "$connectcommand"
    RETVAL=$?
    return $RETVAL
}

check_pid_status
running=$?

# See how we were called.
case "$1" in
    start)
        [ $running -eq 0 ] && exit 0
        start
        ;;
    stop)
        if [ $running -eq 0 ]; then
            stop
        else
            check_pid_status
            RETVAL=$?
            if [ $RETVAL -eq 1 ]; then
                rm -f $lockfile
            fi
            exit 0
        fi
        ;;
    restart|force-reload)
        [ $running -eq 0 ] && stop
        start
        ;;
    hardstop)
        [ $running -eq 0 ] || exit 0
        hardstop
        ;;
    connect)
        connect
        ;;
    condrestart|try-restart)
        [ $running -eq 0 ] || exit 0
        stop
        start
        ;;
    status)

        check_pid_status
        running=$?

        pid=$(beam_pids)

        [ $running -eq 0 ] && echo "eTodo (pid $pid) is running"
        [ $running -eq 1 ] && echo 'eTodo is not running'

        exit $running
        ;;
    *)
        echo $"Usage: $0 {start|stop|restart|force-reload|hardstop|condrestart|try-restart|status|connect}"
        exit 1
esac

exit $?